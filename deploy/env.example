# 正式环境配置。复制成 deploy/.env 再填（./prepaid.sh install 第一次运行会自动复制并生成密钥）。
# deploy/.env 里有密钥，只放在服务器上，不进仓库（.gitignore 已排除），不要发到群里。
# 改完以后：./prepaid.sh upgrade

# ===== 域名（都要解析到这台服务器，并且已 ICP 备案）=====
# 接口：小程序后台「服务器域名」的 request 合法域名填 https://<API_DOMAIN>
API_DOMAIN=api.example.com
# 商家后台网页
ADMIN_DOMAIN=admin.example.com
# 申请 HTTPS 证书用的邮箱（证书快到期没续上时会收到提醒）
ACME_EMAIL=

# ===== 密钥（install 时自动生成，生成后不要改）=====
# 数据库密码，只用字母和数字
POSTGRES_PASSWORD=
# 登录凭证签名密钥，至少 32 位。改了所有人都要重新登录
JWT_SECRET=

# ===== 微信小程序（会员和员工共用一个小程序）=====
WECHAT_MEMBER_APPID=
WECHAT_MEMBER_SECRET=
# 开单后弹的小程序码打开哪个版本：release 正式版 / trial 体验版
WECHAT_MEMBER_CODE_ENV=release

# ===== 开单方式 =====
# paper（默认）：店员拍照上传顾客签字的纸质协议单，上传即充值；esign：电子签（要先办好 e签宝）
SIGN_MODE=paper

# ===== e签宝（SIGN_MODE=esign 时才用到）=====
ESIGN_APP_ID=
ESIGN_APP_SECRET=
# 沙箱 https://smlopenapi.esign.cn ；正式 https://openapi.esign.cn（正式还要把下面的开关打开）
ESIGN_API_HOST=https://smlopenapi.esign.cn
# 正式签署总开关。主体、企业章都办好、坤总明确说开才改成 true
ESIGN_PRODUCTION_ENABLED=false
# 会员签完后签署页跳回的地址，可留空
ESIGN_REDIRECT_URL=

# ===== 对象存储（阿里云 OSS，放合同 PDF、协议单照片和每日备份）=====
# 用一个只能读写这个 Bucket 的 RAM 子账号的 AccessKey，不要用主账号的。
# OSS 的 S3 兼容地址：https://oss-<地域>.aliyuncs.com，例如成都 https://oss-cn-chengdu.aliyuncs.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# OSS 写地域名，例如 oss-cn-chengdu
S3_REGION=oss-cn-chengdu
# OSS 必须是 false（虚拟主机风格）；MinIO 用 true
S3_FORCE_PATH_STYLE=false

# ===== 每日备份 =====
# 每天几点备份（北京时间，HH:MM）
BACKUP_TIME=03:30
# 对象存储里保留几天
BACKUP_RETENTION_DAYS=30
# 服务器本机再留几天（放在 docker 卷 backups 里，对象存储连不上时也有一份）
BACKUP_LOCAL_DAYS=7
# 备份放哪个 Bucket，默认和合同同一个；放在下面这个目录下
BACKUP_BUCKET=
BACKUP_PREFIX=db-backups
# 备份加密口令。强烈建议设：备份里有会员手机号。设了以后务必另外存一份（比如密码管理器），
# 丢了口令备份就打不开。留空则不加密，只靠 Bucket 私有权限保护。
BACKUP_PASSPHRASE=
# 对象存储的类型，给备份上传工具 rclone 用：阿里云 OSS 填 Alibaba，MinIO 填 Minio，其他填 Other
BACKUP_S3_PROVIDER=Alibaba

# ===== 国内服务器的下载镜像（构建镜像时用；海外服务器可以全部留空）=====
NPM_REGISTRY=https://registry.npmmirror.com
APK_MIRROR=mirrors.aliyun.com
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

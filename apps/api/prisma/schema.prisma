// 储值会员 · 数据模型
//
// 账务原则（M2 起由 WalletService.adjust 统一执行）：
// 1. 金额一律为整数分（cent），禁止用浮点元。
// 2. 余额挂在会员 Wallet 上，全公司通用，不按门店拆余额。
// 3. 任何余额变更必须写 LedgerEntry；扣款前校验余额；同一事务内用 Wallet.version 乐观锁。
// 4. LedgerEntry 只追加：数据库触发器拒绝 UPDATE / DELETE / TRUNCATE，纠错只能另记 REVERSAL。
// 5. 余额不能为负、流水前后余额必须对得上，由迁移里的 CHECK 约束兜底（Prisma 不描述 CHECK，见迁移 SQL）。
// 6. 时间字段使用 timestamptz。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgStatus {
  ACTIVE
  DISABLED
}

enum StoreStatus {
  ACTIVE
  DISABLED
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

/// 店员角色。登录后的权限判断按此枚举：超级管理员、店长、店员。
enum StaffRole {
  SUPER_ADMIN
  STORE_MANAGER
  STAFF
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum LedgerType {
  RECHARGE
  CONSUME
  REVERSAL
}

enum BenefitPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ContractTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SignFlowStatus {
  DRAFT
  PENDING
  SIGNED
  REJECTED
  EXPIRED
  CANCELED
}

/// 签署环境。默认沙箱。正式环境仅在 esign.production.enabled 打开后允许写入。
enum SignEnv {
  SANDBOX
  PRODUCTION
}

model Org {
  id        String    @id @default(cuid())
  name      String
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  stores            Store[]
  staff             Staff[]
  members           Member[]
  ledgerEntries     LedgerEntry[]
  benefitPlans      BenefitPlan[]
  contractTemplates ContractTemplate[]
  signFlows         SignFlow[]
  auditLogs         AuditLog[]

  @@map("orgs")
}

model Store {
  id            String      @id @default(cuid())
  orgId         String      @map("org_id")
  name          String
  status        StoreStatus @default(ACTIVE)
  /// 详细地址，供会员导航展示。
  address       String?
  /// 纬度，约六位小数。
  lat           Decimal?    @db.Decimal(9, 6)
  /// 经度，约六位小数。
  lng           Decimal?    @db.Decimal(10, 6)
  /// 联系电话，供会员拨号。
  contactPhone  String?     @map("contact_phone")
  /// 营业时间，原文展示。
  businessHours String?     @map("business_hours")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  org           Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  staffRoles    StaffStoreRole[]
  openedMembers Member[]         @relation("MemberOpenStore")
  ledgerEntries LedgerEntry[]
  auditLogs     AuditLog[]

  @@index([orgId])
  @@map("stores")
}

model Staff {
  id                 String      @id @default(cuid())
  orgId              String      @map("org_id")
  phone              String
  name               String
  status             StaffStatus @default(ACTIVE)
  wxOpenId           String?     @map("wx_open_id")
  /// 网页后台密码，只存 bcrypt 哈希。小程序登录不使用。
  passwordHash       String?     @map("password_hash")
  /// 使用初始密码登录网页后台后必须修改。
  mustChangePassword Boolean     @default(true) @map("must_change_password")
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  lockedUntil        DateTime?   @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  org        Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  storeRoles StaffStoreRole[]
  ledgerOps  LedgerEntry[]    @relation("LedgerOperator")
  auditLogs  AuditLog[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@map("staff")
}

model StaffStoreRole {
  id      String    @id @default(cuid())
  staffId String    @map("staff_id")
  storeId String    @map("store_id")
  role    StaffRole

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([staffId, storeId])
  @@index([storeId])
  @@map("staff_store_roles")
}

model Member {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  phone       String
  /// 开卡时店员登记的称呼，可空。
  name        String?
  wxOpenId    String?      @map("wx_open_id")
  wxUnionId   String?      @map("wx_union_id")
  openStoreId String?      @map("open_store_id")
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Org           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  openStore Store?        @relation("MemberOpenStore", fields: [openStoreId], references: [id], onDelete: SetNull)
  wallet    Wallet?
  ledger    LedgerEntry[]
  signFlows SignFlow[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@map("members")
}

/// 会员钱包。余额全公司通用（挂在会员，不按门店拆分）。有钱包即视为已开卡。
/// balanceCent 单位为分，数据库约束不允许为负。更新余额必须匹配 version 并加一（乐观锁）。
model Wallet {
  id          String   @id @default(cuid())
  memberId    String   @unique @map("member_id")
  balanceCent Int      @default(0) @map("balance_cent")
  version     Int      @default(0)
  /// 开卡时间。
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member  Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@map("wallets")
}

/// 账本流水。只追加，数据库触发器拒绝修改和删除。金额单位为分。
/// amountCent 记绝对值（正整数）。RECHARGE 加、CONSUME 减；REVERSAL 与被冲的原流水方向相反，
/// 实际变动看 balanceAfter - balanceBefore。
model LedgerEntry {
  id              String     @id @default(cuid())
  orgId           String     @map("org_id")
  memberId        String     @map("member_id")
  walletId        String     @map("wallet_id")
  storeId         String     @map("store_id")
  operatorStaffId String?    @map("operator_staff_id")
  type            LedgerType
  amountCent      Int        @map("amount_cent")
  balanceBefore   Int        @map("balance_before")
  balanceAfter    Int        @map("balance_after")
  remark          String?
  /// REVERSAL 指向被冲的原流水。唯一：一笔流水最多冲一次。
  reversalOfId    String?    @unique @map("reversal_of_id")
  /// 客户端生成的请求号。同一组织内唯一，重复提交返回第一次的结果，不会记两笔。
  requestId       String?    @map("request_id")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  org        Org          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  wallet     Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  operator   Staff?       @relation("LedgerOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  reversalOf LedgerEntry? @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy LedgerEntry? @relation("LedgerReversal")

  @@unique([orgId, requestId])
  @@index([orgId, createdAt])
  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([walletId])
  @@map("ledger_entries")
}

model BenefitPlan {
  id          String            @id @default(cuid())
  orgId       String            @map("org_id")
  title       String
  contentJson Json?             @map("content_json")
  status      BenefitPlanStatus @default(DRAFT)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  templates ContractTemplate[]

  @@index([orgId])
  @@map("benefit_plans")
}

model ContractTemplate {
  id              String                 @id @default(cuid())
  orgId           String                 @map("org_id")
  benefitPlanId   String?                @map("benefit_plan_id")
  esignTemplateId String                 @map("esign_template_id")
  name            String
  status          ContractTemplateStatus @default(DRAFT)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  benefitPlan BenefitPlan? @relation(fields: [benefitPlanId], references: [id], onDelete: SetNull)
  signFlows   SignFlow[]

  @@index([orgId])
  @@map("contract_templates")
}

model SignFlow {
  id           String         @id @default(cuid())
  orgId        String         @map("org_id")
  memberId     String         @map("member_id")
  templateId   String         @map("template_id")
  esignFlowId  String?        @map("esign_flow_id")
  status       SignFlowStatus @default(DRAFT)
  signUrl      String?        @map("sign_url")
  pdfObjectKey String?        @map("pdf_object_key")
  env          SignEnv        @default(SANDBOX)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  org      Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([memberId])
  @@map("sign_flows")
}

/// 操作记录。只追加，数据库触发器拒绝修改和删除。
/// storeId 是这次操作发生的门店（开卡、记账、门店和员工开通），店长按它看本店记录；与门店无关的操作为空。
model AuditLog {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  actorStaffId String?  @map("actor_staff_id")
  storeId      String?  @map("store_id")
  action       String
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id")
  payloadJson  Json?    @map("payload_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor Staff? @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([orgId, action, createdAt])
  @@index([orgId, storeId, createdAt])
  @@index([actorStaffId, createdAt])
  @@map("audit_logs")
}

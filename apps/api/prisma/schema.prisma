// 储值会员 · 数据模型
//
// 账务原则（M2 起由 WalletService.adjust 统一执行）：
// 1. 金额一律为整数分（cent），禁止用浮点元。
// 2. 余额挂在会员 Wallet 上，全公司通用，不按门店拆余额。
// 3. 任何余额变更必须写 LedgerEntry；扣款前校验余额；同一事务内用 Wallet.version 乐观锁。
// 4. LedgerEntry 只追加：数据库触发器拒绝 UPDATE / DELETE / TRUNCATE，纠错只能另记 REVERSAL。
// 5. 余额不能为负、流水前后余额必须对得上，由迁移里的 CHECK 约束兜底（Prisma 不描述 CHECK，见迁移 SQL）。
// 6. 时间字段使用 timestamptz。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgStatus {
  ACTIVE
  DISABLED
}

enum StoreStatus {
  ACTIVE
  DISABLED
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

/// 店员角色。登录后的权限判断按此枚举：超级管理员、店长、店员。
enum StaffRole {
  SUPER_ADMIN
  STORE_MANAGER
  STAFF
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum LedgerType {
  RECHARGE
  CONSUME
  REVERSAL
}

enum BenefitPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ContractTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SignFlowStatus {
  DRAFT
  PENDING
  SIGNED
  REJECTED
  EXPIRED
  CANCELED
}

/// 签署环境。默认沙箱。正式环境仅在 esign.production.enabled 打开后允许写入。
enum SignEnv {
  SANDBOX
  PRODUCTION
}

model Org {
  id        String    @id @default(cuid())
  name      String
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  stores            Store[]
  staff             Staff[]
  members           Member[]
  ledgerEntries     LedgerEntry[]
  benefitPlans      BenefitPlan[]
  contractTemplates ContractTemplate[]
  signFlows         SignFlow[]
  auditLogs         AuditLog[]
  payCodes          MemberPayCode[]

  @@map("orgs")
}

model Store {
  id            String      @id @default(cuid())
  orgId         String      @map("org_id")
  name          String
  status        StoreStatus @default(ACTIVE)
  /// 详细地址，供会员导航展示。
  address       String?
  /// 纬度，约六位小数。
  lat           Decimal?    @db.Decimal(9, 6)
  /// 经度，约六位小数。
  lng           Decimal?    @db.Decimal(10, 6)
  /// 联系电话，供会员拨号。
  contactPhone  String?     @map("contact_phone")
  /// 营业时间，原文展示。
  businessHours String?     @map("business_hours")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  org           Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  staffRoles    StaffStoreRole[]
  openedMembers Member[]         @relation("MemberOpenStore")
  ledgerEntries LedgerEntry[]
  auditLogs     AuditLog[]
  signFlows     SignFlow[]
  payCodeScans  MemberPayCode[]

  @@index([orgId])
  @@map("stores")
}

model Staff {
  id                 String      @id @default(cuid())
  orgId              String      @map("org_id")
  phone              String
  name               String
  status             StaffStatus @default(ACTIVE)
  wxOpenId           String?     @map("wx_open_id")
  /// 网页后台密码，只存 bcrypt 哈希。小程序登录不使用。
  passwordHash       String?     @map("password_hash")
  /// 使用初始密码登录网页后台后必须修改。改之前，密码登录的凭证只能改密码、看本人信息（服务端拦截）。
  mustChangePassword Boolean     @default(true) @map("must_change_password")
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  lockedUntil        DateTime?   @map("locked_until") @db.Timestamptz(6)
  /// 登录版本号，写进登录凭证。改密码、重置密码时加一，之前签发的凭证全部作废。
  sessionVersion     Int         @default(0) @map("session_version")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  org                Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  storeRoles         StaffStoreRole[]
  ledgerOps          LedgerEntry[]    @relation("LedgerOperator")
  auditLogs          AuditLog[]
  initiatedSignFlows SignFlow[]       @relation("SignFlowInitiator")
  payCodeScans       MemberPayCode[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@map("staff")
}

model StaffStoreRole {
  id      String    @id @default(cuid())
  staffId String    @map("staff_id")
  storeId String    @map("store_id")
  role    StaffRole

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([staffId, storeId])
  @@index([storeId])
  @@map("staff_store_roles")
}

model Member {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  phone       String
  /// 开卡时店员登记的称呼，可空。
  name        String?
  wxOpenId    String?      @map("wx_open_id")
  wxUnionId   String?      @map("wx_union_id")
  openStoreId String?      @map("open_store_id")
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Org           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  openStore Store?        @relation("MemberOpenStore", fields: [openStoreId], references: [id], onDelete: SetNull)
  wallet    Wallet?
  ledger    LedgerEntry[]
  signFlows SignFlow[]
  payCodes  MemberPayCode[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@map("members")
}

/// 会员钱包。余额全公司通用（挂在会员，不按门店拆分）。有钱包即视为已开卡。
/// balanceCent 单位为分，数据库约束不允许为负。更新余额必须匹配 version 并加一（乐观锁）。
model Wallet {
  id          String   @id @default(cuid())
  memberId    String   @unique @map("member_id")
  balanceCent Int      @default(0) @map("balance_cent")
  version     Int      @default(0)
  /// 开卡时间。
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member  Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@map("wallets")
}

/// 账本流水。只追加，数据库触发器拒绝修改和删除。金额单位为分。
/// amountCent 记绝对值（正整数）。RECHARGE 加、CONSUME 减；REVERSAL 与被冲的原流水方向相反，
/// 实际变动看 balanceAfter - balanceBefore。
model LedgerEntry {
  id              String     @id @default(cuid())
  orgId           String     @map("org_id")
  memberId        String     @map("member_id")
  walletId        String     @map("wallet_id")
  storeId         String     @map("store_id")
  operatorStaffId String?    @map("operator_staff_id")
  type            LedgerType
  amountCent      Int        @map("amount_cent")
  balanceBefore   Int        @map("balance_before")
  balanceAfter    Int        @map("balance_after")
  remark          String?
  /// REVERSAL 指向被冲的原流水。唯一：一笔流水最多冲一次。
  reversalOfId    String?    @unique @map("reversal_of_id")
  /// 客户端生成的请求号。同一组织内唯一，重复提交返回第一次的结果，不会记两笔。
  requestId       String?    @map("request_id")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  org        Org          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  wallet     Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  operator   Staff?       @relation("LedgerOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  reversalOf LedgerEntry? @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy LedgerEntry? @relation("LedgerReversal")
  payCode    MemberPayCode?

  @@unique([orgId, requestId])
  @@index([orgId, createdAt])
  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([walletId])
  @@map("ledger_entries")
}

/// 会员码的状态。过期不单独存，按 expiresAt / claimExpiresAt 判断。
enum PayCodeStatus {
  /// 会员小程序正在出示，还没被扫。
  ISSUED
  /// 店员已扫码，在 claimExpiresAt 之前可由这位店员在这家门店扣一次款。
  SCANNED
  /// 已经用来扣过款，不能再用。
  USED
}

/// 会员码：会员小程序出示的二维码。消费扣款必须先由店员扫码，所以店员不能在会员不在场时扣款。
/// 只能用一次、出示后很快过期，会员换新码时旧的未扫码作废。库里只存码的哈希。
model MemberPayCode {
  id               String        @id @default(cuid())
  orgId            String        @map("org_id")
  memberId         String        @map("member_id")
  /// 码的 SHA-256。码本身只在发给会员小程序时出现一次。
  codeHash         String        @unique @map("code_hash")
  status           PayCodeStatus @default(ISSUED)
  /// 没扫的码到这个时间作废。
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  scannedAt        DateTime?     @map("scanned_at") @db.Timestamptz(6)
  scannedByStaffId String?       @map("scanned_by_staff_id")
  scannedStoreId   String?       @map("scanned_store_id")
  /// 扫码后要在这个时间之前扣款，过了要重新扫。
  claimExpiresAt   DateTime?     @map("claim_expires_at") @db.Timestamptz(6)
  usedAt           DateTime?     @map("used_at") @db.Timestamptz(6)
  /// 用这个码扣的那笔流水。
  ledgerEntryId    String?       @unique @map("ledger_entry_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  org          Org          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  scannedBy    Staff?       @relation(fields: [scannedByStaffId], references: [id], onDelete: SetNull)
  scannedStore Store?       @relation(fields: [scannedStoreId], references: [id], onDelete: Restrict)
  ledgerEntry  LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([memberId, status])
  @@map("member_pay_codes")
}

model BenefitPlan {
  id          String            @id @default(cuid())
  orgId       String            @map("org_id")
  title       String
  contentJson Json?             @map("content_json")
  status      BenefitPlanStatus @default(DRAFT)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  templates ContractTemplate[]

  @@index([orgId])
  @@map("benefit_plans")
}

/// 权益单模板：绑定 e签宝文件模板。发起时按关键字找签名和盖章的位置。
model ContractTemplate {
  id                String                 @id @default(cuid())
  orgId             String                 @map("org_id")
  benefitPlanId     String?                @map("benefit_plan_id")
  esignTemplateId   String                 @map("esign_template_id")
  name              String
  status            ContractTemplateStatus @default(DRAFT)
  /// 合同正文里会员签名位置的关键字。签名落在关键字右侧。
  memberSignKeyword String                 @default("会员签字") @map("member_sign_keyword")
  /// 合同正文里商家盖章位置的关键字。企业章盖在关键字上。
  sealKeyword       String                 @default("商家盖章") @map("seal_keyword")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  org         Org          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  benefitPlan BenefitPlan? @relation(fields: [benefitPlanId], references: [id], onDelete: SetNull)
  signFlows   SignFlow[]

  @@index([orgId])
  @@map("contract_templates")
}

/// 一份权益单的签署。会员个人签 + 商家企业章（沙箱为平台自动盖章）。
/// env 记录实际调用的 e签宝环境，由网关地址决定；正式环境只有总开关打开后才允许。
/// 同一会员同一模板最多一份未完成（DRAFT / PENDING），由迁移里的部分唯一索引保证。
model SignFlow {
  id               String         @id @default(cuid())
  orgId            String         @map("org_id")
  memberId         String         @map("member_id")
  templateId       String         @map("template_id")
  /// 发起门店。店长、店员只看本店发起的。
  storeId          String?        @map("store_id")
  initiatorStaffId String?        @map("initiator_staff_id")
  /// 发起时的合同标题（模板名快照）。
  title            String         @default("")
  esignFlowId      String?        @unique @map("esign_flow_id")
  esignFileId      String?        @map("esign_file_id")
  status           SignFlowStatus @default(DRAFT)
  /// 最近一次取到的签署链接，只在 PENDING 时有效。会员端每次打开前重新取。
  signUrl          String?        @map("sign_url")
  pdfObjectKey     String?        @map("pdf_object_key")
  env              SignEnv        @default(SANDBOX)
  /// 客户端生成的请求号，同一组织内唯一，重复提交返回第一次的结果。
  requestId        String?        @map("request_id")
  signedAt         DateTime?      @map("signed_at") @db.Timestamptz(6)
  /// 最近一次和 e签宝核对状态的时间。
  syncedAt         DateTime?      @map("synced_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  template  ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  store     Store?           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  initiator Staff?           @relation("SignFlowInitiator", fields: [initiatorStaffId], references: [id], onDelete: SetNull)

  @@unique([orgId, requestId])
  @@index([orgId, createdAt])
  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@map("sign_flows")
}

/// 操作记录。只追加，数据库触发器拒绝修改和删除。
/// storeId 是这次操作发生的门店（开卡、记账、门店和员工开通），店长按它看本店记录；与门店无关的操作为空。
model AuditLog {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  actorStaffId String?  @map("actor_staff_id")
  storeId      String?  @map("store_id")
  action       String
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id")
  payloadJson  Json?    @map("payload_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor Staff? @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([orgId, action, createdAt])
  @@index([orgId, storeId, createdAt])
  @@index([actorStaffId, createdAt])
  @@map("audit_logs")
}

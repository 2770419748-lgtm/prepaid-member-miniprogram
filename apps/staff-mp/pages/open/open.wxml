<view class="page">
  <block wx:if="{{done}}">
    <view class="done">
      <view class="done-icon"><text>✓</text></view>
      <text class="done-title">开卡成功</text>
      <text class="muted">余额 0.00 元，全公司门店通用</text>
    </view>
    <view class="card">
      <view class="kv"><text class="kv-key">会员</text><text class="kv-value">{{done.label}}</text></view>
      <view class="kv"><text class="kv-key">开卡门店</text><text class="kv-value">{{done.storeName}}</text></view>
      <view class="kv"><text class="kv-key">开卡时间</text><text class="kv-value">{{done.time}}</text></view>
    </view>
    <view class="btn btn-primary" hover-class="is-pressed" bindtap="onRecharge">去充值</view>
    <view class="btn btn-quiet" hover-class="is-pressed" bindtap="onHome">返回工作台</view>
  </block>

  <block wx:else>
    <text wx:if="{{noStore}}" class="notice notice-warning">你所在的门店都已停用，暂时不能开卡。</text>
    <view class="card">
      <view class="field">
        <text class="field-label">会员手机号</text>
        <input
          class="field-input"
          type="number"
          maxlength="11"
          placeholder="11 位手机号"
          placeholder-class="placeholder"
          value="{{phone}}"
          focus="{{!phone}}"
          bindinput="onPhoneInput"
        />
        <text wx:if="{{phoneError}}" class="error">{{phoneError}}</text>
      </view>
      <view class="field">
        <text class="field-label">称呼（选填）</text>
        <input
          class="field-input"
          maxlength="40"
          placeholder="如：王女士"
          placeholder-class="placeholder"
          value="{{name}}"
          bindinput="onNameInput"
        />
      </view>
      <view class="field">
        <text class="field-label">开卡门店</text>
        <text class="field-value">{{storeName}}</text>
      </view>
    </view>

    <view wx:if="{{existingId}}" class="card">
      <text class="result-text">这个手机号已经开过卡了，不用重复开。</text>
      <view class="btn btn-plain" hover-class="is-pressed" bindtap="onViewExisting">查看这位会员</view>
    </view>

    <text class="hint rules">开卡后余额为 0，充值在开卡后办理。余额在公司所有门店通用，长期有效、用完为止。</text>
    <view class="btn btn-primary {{submitting || noStore ? 'is-disabled' : ''}}" hover-class="is-pressed" bindtap="onSubmit">{{submitting ? '正在开卡…' : '确认开卡'}}</view>
  </block>
</view>

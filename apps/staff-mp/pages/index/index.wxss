.store-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.store-line {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.store-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.search-input {
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: var(--bg);
  border: 2rpx solid var(--line);
  font-size: 40rpx;
  letter-spacing: 2rpx;
}

.search-btn {
  margin-top: 24rpx;
}

.result {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--line);
}

.entry-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.footnote {
  display: block;
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  margin-top: 64rpx;
}

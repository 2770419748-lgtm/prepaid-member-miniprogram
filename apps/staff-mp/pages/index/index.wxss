.store-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.store-line {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.store-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.search-input {
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: var(--bg);
  border: 2rpx solid var(--line);
  font-size: 40rpx;
  letter-spacing: 2rpx;
}

.search-btn {
  margin-top: 24rpx;
}

.result {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--line);
}

.entry-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.footnote {
  display: block;
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  margin-top: 64rpx;
}

/* 扫码消费：门店最常做的一件事，放在最上面、最显眼。 */
.scan-card {
  display: flex;
  align-items: center;
  background: var(--primary);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.scan-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  margin-right: 28rpx;
}

.scan-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-color: #ffffff;
  border-style: solid;
  border-width: 0;
}

.scan-corner.tl {
  left: 0;
  top: 0;
  border-left-width: 6rpx;
  border-top-width: 6rpx;
  border-top-left-radius: 8rpx;
}

.scan-corner.tr {
  right: 0;
  top: 0;
  border-right-width: 6rpx;
  border-top-width: 6rpx;
  border-top-right-radius: 8rpx;
}

.scan-corner.bl {
  left: 0;
  bottom: 0;
  border-left-width: 6rpx;
  border-bottom-width: 6rpx;
  border-bottom-left-radius: 8rpx;
}

.scan-corner.br {
  right: 0;
  bottom: 0;
  border-right-width: 6rpx;
  border-bottom-width: 6rpx;
  border-bottom-right-radius: 8rpx;
}

.scan-line {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 41rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #ffffff;
}

.scan-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.scan-title {
  font-size: 38rpx;
  font-weight: 600;
}

.scan-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.85;
  line-height: 1.5;
}

.scan-card.is-pressed {
  opacity: 0.85;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.head-store {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  word-break: break-all;
}

.head .muted {
  flex-shrink: 0;
  white-space: nowrap;
}

.chips {
  display: flex;
  margin-top: 16rpx;
}

.chip {
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  color: var(--text-2);
  font-size: 26rpx;
  margin-right: 16rpx;
}

.chip-on {
  color: var(--primary);
  background: var(--primary-soft);
  border-color: var(--primary);
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.head-store {
  font-size: 36rpx;
  font-weight: 600;
}

.chips {
  display: flex;
  margin-top: 16rpx;
}

.chip {
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  color: var(--text-2);
  font-size: 26rpx;
  margin-right: 16rpx;
}

.chip-on {
  color: var(--primary);
  background: var(--primary-soft);
  border-color: var(--primary);
}

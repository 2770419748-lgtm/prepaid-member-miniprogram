.profile {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.row-value {
  color: var(--text-2);
  font-size: 28rpx;
}

.about {
  margin-top: 24rpx;
}

.logout {
  margin-top: 48rpx;
  color: var(--danger);
}

<view class="page">
  <text wx:if="{{error}}" class="notice notice-danger">{{error}}</text>

  <block wx:if="{{member}}">
    <view class="card">
      <view class="member-head">
        <text class="member-phone">{{member.phone}}</text>
        <text wx:if="{{member.name}}" class="member-name">{{member.name}}</text>
        <text wx:if="{{member.disabled}}" class="tag tag-danger">已停用</text>
      </view>
      <text class="muted open-info">{{member.openInfo}}<text wx:if="{{member.openTail}}" class="nowrap">{{member.openTail}}</text></text>
      <view class="balance-block">
        <text class="muted">余额（全公司门店通用）</text>
        <view class="balance">
          <text class="balance-number">{{member.balance}}</text>
          <text class="balance-unit">元</text>
        </view>
      </view>
    </view>

    <text wx:if="{{member.disabled}}" class="notice notice-warning">该会员已停用，不能记账。需要恢复请联系管理员。</text>
    <block wx:elif="{{!member.hasCard}}">
      <text class="notice notice-warning">该会员还没开卡。开单时会一起开卡，签完合同充值到账。</text>
      <view class="btn btn-primary" hover-class="is-pressed" bindtap="onOpenCard">为他开单</view>
    </block>
    <text wx:elif="{{noStore}}" class="notice notice-warning">你所在的门店都已停用，暂时不能记账。</text>
    <block wx:else>
      <view class="btn-row">
        <view class="btn btn-plain" hover-class="is-pressed" bindtap="onRecharge">充值</view>
        <view class="btn btn-primary" hover-class="is-pressed" bindtap="onConsume">扫码消费</view>
      </view>
      <text class="hint consume-hint">消费要先扫顾客小程序里的会员码</text>
      <view class="entry-row" hover-class="is-pressed" bindtap="onOrder">
        <view class="row-main">
          <text class="row-title">办理权益单</text>
          <text class="row-sub">填会员权益金额，顾客签完合同自动充值</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </block>

    <block wx:if="{{openOrders.length}}">
      <view class="section-title"><text>待签署的权益单</text></view>
      <view class="list">
        <view wx:for="{{openOrders}}" wx:key="id" class="row" hover-class="is-pressed" data-id="{{item.id}}" bindtap="onOpenOrder">
          <view class="row-main">
            <text class="row-title">{{item.title}} <text class="tag tag-warning">待签署</text></text>
            <text wx:if="{{item.amount}}" class="row-sub">{{item.amount}} · 签完才到账</text>
          </view>
          <text class="link">接着签 ›</text>
        </view>
      </view>
    </block>

    <view class="section-title">
      <text>{{historyTitle}}</text>
      <text class="muted">{{historyNote}}</text>
    </view>
    <view wx:if="{{rows.length}}" class="list">
      <view wx:for="{{rows}}" wx:key="id" class="row" hover-class="is-pressed" data-id="{{item.id}}" bindtap="onEntry">
        <view class="row-main">
          <text class="row-title">{{item.title}} <text wx:if="{{item.reversed}}" class="tag tag-gray">已冲正</text></text>
          <text class="row-sub">{{item.date}} {{item.meta}}</text>
        </view>
        <view class="row-side">
          <text class="row-amount {{item.tone}}">{{item.change}}</text>
          <text class="row-sub">余额 {{item.balanceAfter}}</text>
        </view>
      </view>
    </view>
    <text wx:elif="{{!loading}}" class="empty">{{historyEmpty}}</text>
  </block>
</view>

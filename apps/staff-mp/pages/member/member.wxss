.member-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.member-phone {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.member-name {
  font-size: 30rpx;
  margin: 0 16rpx;
}

.balance-block {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.consume-hint {
  margin-top: 16rpx;
  text-align: right;
}

.entry-row {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-top: 24rpx;
}

/* 名字太长时整段换到手机号下一行，不挤成窄条。 */
.member-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 8rpx;
}

.member-phone {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-right: 16rpx;
}

.member-name {
  font-size: 30rpx;
  margin-right: 16rpx;
  word-break: break-all;
}

.open-info {
  display: block;
}

.nowrap {
  white-space: nowrap;
}

.balance-block {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.consume-hint {
  margin-top: 16rpx;
  text-align: right;
}

.entry-row {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-top: 24rpx;
}

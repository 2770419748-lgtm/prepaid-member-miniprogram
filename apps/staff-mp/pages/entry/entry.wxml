<view class="page">
  <text wx:if="{{error}}" class="notice notice-danger">{{error}}</text>

  <block wx:if="{{done}}">
    <view class="done">
      <view class="done-icon"><text>✓</text></view>
      <text class="done-title">{{done.title}}</text>
      <text class="done-change {{done.tone}}">{{done.change}} 元</text>
    </view>
    <text wx:if="{{done.replayed}}" class="notice notice-info">这笔之前已经记上了，这次没有重复记账。</text>
    <view class="card">
      <view class="kv"><text class="kv-key">会员</text><text class="kv-value">{{memberLabel}}</text></view>
      <view class="kv"><text class="kv-key">当前余额</text><text class="kv-value strong">{{done.balance}} 元</text></view>
      <view class="kv"><text class="kv-key">门店</text><text class="kv-value">{{done.storeName}}</text></view>
      <view class="kv"><text class="kv-key">时间</text><text class="kv-value">{{done.time}}</text></view>
      <view wx:if="{{done.remark}}" class="kv"><text class="kv-key">备注</text><text class="kv-value">{{done.remark}}</text></view>
    </view>
    <view class="btn btn-primary" hover-class="is-pressed" bindtap="onBackToMember">返回会员</view>
    <view class="btn btn-quiet" hover-class="is-pressed" bindtap="onNextMember">办理下一位</view>
  </block>

  <block wx:elif="{{needCode}}">
    <view class="card scan-need">
      <text class="card-title">消费要先扫会员码</text>
      <text class="hint">请顾客打开会员小程序，点「会员码」，再用下面的按钮扫码。扫到才能填扣款金额。</text>
    </view>
    <view class="btn btn-primary" hover-class="is-pressed" bindtap="onRescan">扫会员码</view>
  </block>

  <block wx:elif="{{ready}}">
    <view class="card summary">
      <view class="kv"><text class="kv-key">会员</text><text class="kv-value">{{memberLabel}}</text></view>
      <view class="kv"><text class="kv-key">当前余额</text><text class="kv-value">{{balance}} 元</text></view>
      <view class="kv"><text class="kv-key">记账门店</text><text class="kv-value">{{storeName}}</text></view>
      <view wx:if="{{kind === 'CONSUME'}}" class="kv">
        <text class="kv-key">会员码</text>
        <text class="kv-value code-ok">已扫码{{codeText ? ' · ' + codeText : ''}}</text>
      </view>
    </view>

    <view class="card">
      <text class="field-label">{{kindLabel}}金额（元）</text>
      <view class="amount-line">
        <text class="amount-symbol">¥</text>
        <input
          class="amount-input"
          type="digit"
          placeholder="0.00"
          placeholder-class="placeholder"
          value="{{amount}}"
          disabled="{{uncertain}}"
          focus="{{!uncertain}}"
          bindinput="onAmountInput"
        />
      </view>
      <text wx:if="{{amountError}}" class="error">{{amountError}}</text>
      <text wx:elif="{{afterText}}" class="hint after">{{afterText}}</text>
      <view class="field remark">
        <text class="field-label">备注（选填，会员看不到）</text>
        <input
          class="field-input"
          maxlength="200"
          placeholder="{{remarkPlaceholder}}"
          placeholder-class="placeholder"
          value="{{remark}}"
          disabled="{{uncertain}}"
          bindinput="onRemarkInput"
        />
      </view>
    </view>

    <block wx:if="{{uncertain}}">
      <text class="notice notice-warning">刚才的提交没有收到结果，可能已经记上了。点「重试」不会重复记账；也可以先回会员页看看余额。</text>
      <view class="btn btn-primary {{submitting ? 'is-disabled' : ''}}" hover-class="is-pressed" bindtap="onRetry">{{submitting ? '正在提交…' : '重试'}}</view>
      <view class="btn btn-quiet" hover-class="is-pressed" bindtap="onBackToMember">回会员页核对</view>
    </block>
    <view
      wx:else
      class="btn btn-primary {{canSubmit && !submitting ? '' : 'is-disabled'}}"
      hover-class="is-pressed"
      bindtap="onSubmit"
    >{{submitting ? '正在提交…' : submitText}}</view>
  </block>
</view>

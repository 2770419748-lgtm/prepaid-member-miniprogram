/* 步骤条：手机号 → 填权益 → 签合同 → 到账 */
.steps {
  display: flex;
  justify-content: space-between;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  background: #f1f5f9;
  color: var(--text-3);
}

.step-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.step-current .step-dot {
  background: var(--primary);
  color: #ffffff;
}

.step-current .step-label {
  color: var(--primary);
  font-weight: 500;
}

.step-done .step-dot {
  background: var(--primary-soft);
  color: var(--primary);
}

.step-done .step-label {
  color: var(--text-2);
}

.rules {
  margin: 8rpx 8rpx 32rpx;
}

/* 第二步：名字再长也只在左边折行，「换一位」固定在右上角，不压住名字和标签。 */
.member-top {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.member-line {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.member-label {
  font-size: 34rpx;
  font-weight: 600;
  margin-right: 16rpx;
  word-break: break-all;
}

.change {
  flex-shrink: 0;
  margin-left: 24rpx;
  font-size: 26rpx;
  line-height: 51rpx;
  white-space: nowrap;
}

.benefit-first,
.benefit-item {
  display: flex;
  align-items: flex-start;
}

.benefit-first {
  padding-bottom: 24rpx;
}

.benefit-rest {
  border-top: 2rpx solid var(--line);
  padding-top: 8rpx;
}

.benefit-item {
  padding: 16rpx 0;
}

.benefit-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx 20rpx 0 0;
  flex-shrink: 0;
}

.benefit-body {
  flex: 1;
  min-width: 0;
}

.benefit-title {
  display: block;
  font-size: 30rpx;
}

.benefit-first .benefit-title {
  font-weight: 600;
}

.benefit-rules {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
}

.amount-line {
  display: flex;
  align-items: center;
  padding: 8rpx 0 12rpx;
  margin-bottom: 8rpx;
  border-bottom: 2rpx solid var(--line);
}

.amount-symbol {
  font-size: 48rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  height: 96rpx;
  font-size: 60rpx;
  font-weight: 600;
}

.amount-unit {
  color: var(--text-2);
  font-size: 28rpx;
}

.choice {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.choice-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--text-3);
  margin-right: 20rpx;
  box-sizing: border-box;
}

.choice.is-on .choice-radio {
  border: 10rpx solid var(--primary);
}

.choice-text {
  font-size: 30rpx;
}

.plain-kv {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

/* 第三步 */
.sign-card {
  padding-bottom: 24rpx;
}

.sign-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

.sign-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.qr-box {
  position: relative;
  display: flex;
  justify-content: center;
  margin: 32rpx auto 16rpx;
}

.qr {
  width: 440rpx;
  height: 440rpx;
}

.qr-wait {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.waiting {
  display: flex;
  align-items: center;
  justify-content: center;
}

.waiting-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--warning);
  margin-right: 12rpx;
}

.ended-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: var(--warning);
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ended-text {
  text-align: center;
  padding: 0 32rpx;
}

.strong {
  font-weight: 600;
}

.later {
  margin-top: 24rpx;
}

.btn-danger {
  margin-top: 24rpx;
}

.center {
  text-align: center;
  margin-top: 24rpx;
}

/* 第四步 */
.done-change {
  font-size: 56rpx;
  font-weight: 600;
}

/* 弹出的会员小程序码：和页面卡片一样宽，背后的页面压暗，不从两边露出来。 */
.code-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  z-index: 10;
}

.code-sheet {
  width: 100%;
  max-width: 686rpx;
  background: var(--card);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
}

.code-sub {
  margin-top: 16rpx;
  text-align: center;
  color: var(--text-2);
  font-size: 26rpx;
}

.code-phone {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.code-box {
  display: flex;
  justify-content: center;
  margin: 24rpx 0 0;
}

.code-image {
  width: 440rpx;
  height: 440rpx;
}

.code-fallback {
  font-size: 28rpx;
  line-height: 1.6;
}

.code-note {
  align-self: stretch;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--warning-soft);
  color: #92400e;
  font-size: 24rpx;
  line-height: 1.6;
}

.code-note-tag {
  margin-right: 12rpx;
  background: #ffffff;
}

.code-sheet .btn {
  align-self: stretch;
  margin-top: 32rpx;
}

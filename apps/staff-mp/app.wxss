/*
 * 色板、字号、间距对齐 docs/design/ui-design.md v1.1，与会员端共用。
 * 750rpx = 屏幕宽；设计稿 1px = 2rpx。间距刻度 8/16/24/32/48/64rpx。
 */
page {
  --primary: #1677ff;
  --primary-deep: #0958d9;
  --primary-soft: #e8f1ff;
  --text: #0f172a;
  --text-2: #64748b;
  --text-3: #94a3b8;
  --line: #e2e8f0;
  --bg: #f8fafc;
  --card: #ffffff;
  --success: #16a34a;
  --success-soft: #ecfdf3;
  --warning: #d97706;
  --warning-soft: #fff7ed;
  --danger: #dc2626;
  --danger-soft: #fef2f2;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.page {
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 500;
  margin: 48rpx 0 16rpx;
}

.section-title .muted {
  font-weight: 400;
}

.muted {
  color: var(--text-2);
  font-size: 24rpx;
}

.hint {
  display: block;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 按钮：用 view 画，不受微信 button 默认样式影响。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--primary);
  color: #ffffff;
}

.btn-plain {
  background: var(--card);
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-quiet {
  background: var(--card);
  color: var(--text);
  border: 2rpx solid var(--line);
}

.btn-danger {
  background: var(--card);
  color: var(--danger);
  border: 2rpx solid var(--danger);
}

.btn.is-disabled {
  opacity: 0.4;
}

.btn.is-pressed {
  opacity: 0.8;
}

.btn-row {
  display: flex;
}

.btn-row .btn {
  flex: 1;
}

.btn-row .btn + .btn {
  margin-left: 24rpx;
}

.btn + .btn {
  margin-top: 24rpx;
}

.btn-row .btn + .btn {
  margin-top: 0;
}

.link {
  color: var(--primary);
}

/* 表单 */
.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  display: block;
  color: var(--text-2);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.field-input {
  height: 64rpx;
  font-size: 32rpx;
  color: var(--text);
}

.field-value {
  display: block;
  font-size: 32rpx;
  line-height: 64rpx;
}

.placeholder {
  color: var(--text-3);
}

.error {
  display: block;
  color: var(--danger);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 金额颜色：增加成功色「+」，扣减危险色「-」 */
.plus {
  color: var(--success);
}

.minus {
  color: var(--danger);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  vertical-align: middle;
}

.tag-primary {
  color: var(--primary);
  background: var(--primary-soft);
}

.tag-gray {
  color: var(--text-2);
  background: #f1f5f9;
}

.tag-warning {
  color: var(--warning);
  background: var(--warning-soft);
}

.tag-danger {
  color: var(--danger);
  background: var(--danger-soft);
}

/* 提示条 */
.notice {
  display: block;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.notice-warning {
  color: #92400e;
  background: var(--warning-soft);
}

.notice-danger {
  color: #991b1b;
  background: var(--danger-soft);
}

.notice-info {
  color: var(--text-2);
  background: #f1f5f9;
}

/* 列表 */
.list {
  background: var(--card);
  border-radius: 24rpx;
  padding: 0 32rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-size: 30rpx;
}

.row-sub {
  display: block;
  color: var(--text-2);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.row-side {
  text-align: right;
  margin-left: 24rpx;
}

.row-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
}

.row-arrow {
  color: var(--text-3);
  margin-left: 16rpx;
  font-size: 28rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.kv-key {
  color: var(--text-2);
  flex-shrink: 0;
  margin-right: 32rpx;
}

.kv-value {
  text-align: right;
  word-break: break-all;
}

/* 空态与加载 */
.empty {
  display: block;
  text-align: center;
  color: var(--text-2);
  font-size: 26rpx;
  padding: 64rpx 0;
}

.loading-more {
  display: block;
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  padding: 32rpx 0;
}

/* 余额大数字：页面唯一焦点 */
.balance {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.balance-number {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.balance-unit {
  font-size: 28rpx;
  margin-left: 8rpx;
  color: var(--text-2);
}

/* 办理成功 */
.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.done-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: var(--success);
  color: #ffffff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-title {
  margin: 24rpx 0 8rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.result-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

<view class="page has-tabbar">
  <view class="card profile">
    <view class="avatar"><text>{{initial}}</text></view>
    <view class="row-main">
      <text class="profile-name">{{name}}</text>
      <text class="muted">{{phone}}</text>
    </view>
  </view>

  <view class="list">
    <view class="row" hover-class="{{canSwitch ? 'is-pressed' : 'none'}}" bindtap="onSwitchStore">
      <text class="row-main row-title">当前门店</text>
      <text class="row-value">{{storeName}}</text>
      <text wx:if="{{canSwitch}}" class="row-arrow">›</text>
    </view>
    <view class="row">
      <text class="row-main row-title">我的角色</text>
      <text class="row-value">{{roleLabel}}</text>
    </view>
    <view class="row">
      <text class="row-main row-title">能办理业务的门店</text>
      <text class="row-value">{{storeCount}}</text>
    </view>
  </view>

  <view class="list mycard">
    <view class="row" hover-class="is-pressed" bindtap="onMyCard">
      <view class="row-main">
        <text class="row-title">{{switching ? '正在切换…' : '切到我的会员卡'}}</text>
        <text class="row-sub">看自己的余额、出示会员码，随时回到工作台</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <text class="notice notice-info about">本小程序只记账，不收款。钱在门店线下收取；会员的余额在公司所有门店通用。</text>

  <view class="btn btn-quiet logout" hover-class="is-pressed" bindtap="onLogout">退出登录</view>
</view>

<!-- 工作台自己的底栏，见 staff/utils/nav.ts。 -->
<view class="tabbar">
  <view class="tabbar-item" data-tab="index" bindtap="onTab">
    <image class="tabbar-icon" src="/staff/images/tab/home.png"></image>
    <text>工作台</text>
  </view>
  <view class="tabbar-item" data-tab="ledger" bindtap="onTab">
    <image class="tabbar-icon" src="/staff/images/tab/ledger.png"></image>
    <text>本店流水</text>
  </view>
  <view class="tabbar-item is-active">
    <image class="tabbar-icon" src="/staff/images/tab/mine-active.png"></image>
    <text>我的</text>
  </view>
</view>

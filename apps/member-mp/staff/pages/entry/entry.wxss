@import "../../staff.wxss";

.summary {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.amount-line {
  display: flex;
  align-items: center;
  padding: 8rpx 0 16rpx;
  border-bottom: 2rpx solid var(--line);
}

.amount-symbol {
  font-size: 56rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  height: 112rpx;
  font-size: 72rpx;
  font-weight: 600;
}

.after {
  margin-top: 12rpx;
}

.remark {
  margin-top: 16rpx;
  padding-bottom: 0;
}

.done-change {
  font-size: 56rpx;
  font-weight: 600;
}

.strong {
  font-weight: 600;
}

.code-ok {
  color: var(--success);
}

.scan-need {
  margin-bottom: 32rpx;
}

/* 消费：九讯云订单 */
.order-line {
  display: flex;
  align-items: center;
  min-height: 64rpx;
}

.order-no {
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.order-change {
  margin-left: auto;
  padding-left: 24rpx;
  flex-shrink: 0;
}

.scan-order {
  margin-top: 16rpx;
}

.order-switch {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.order-type {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--line);
}

.order-input {
  flex: 1;
  min-width: 0;
}

.order-ok {
  width: 144rpx;
  height: 64rpx;
  font-size: 28rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.product-line {
  padding: 8rpx 0 12rpx;
  border-bottom: 2rpx solid var(--line);
}

.product-input {
  font-size: 40rpx;
  height: 72rpx;
  font-weight: 600;
}

.cap {
  margin-top: 12rpx;
}

.offset-label {
  margin-top: 32rpx;
}

/* 无码抵扣 */
.code-skip {
  color: var(--warning);
}

.reason-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.reason-chip {
  font-size: 26rpx;
  line-height: 1;
  padding: 14rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text-2);
  border: 2rpx solid var(--line);
}

.reason-chip.is-picked {
  color: var(--primary);
  border-color: var(--primary);
  background: var(--primary-soft);
}

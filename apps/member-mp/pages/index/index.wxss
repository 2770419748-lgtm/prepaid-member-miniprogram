.member-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  position: relative;
  overflow: hidden;
}

/* 卡面右上角一道很淡的主色，克制地点出品牌。 */
.member-card::before {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -160rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: rgba(22, 119, 255, 0.06);
}

.mc-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  position: relative;
}

.mc-greeting {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 500;
  word-break: break-all;
}

.mc-phone {
  flex-shrink: 0;
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #64748b;
  font-variant-numeric: tabular-nums;
}

.mc-label {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #64748b;
}

.mc-amount {
  margin-top: 4rpx;
  display: flex;
  align-items: baseline;
}

.mc-balance {
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.mc-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.mc-foot {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e2e8f0;
  font-size: 24rpx;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 会员码入口：到店消费时最常用的一步，放在余额旁边。 */
.mc-code {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx 0 22rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.mc-code-hover {
  background: #0958d9;
}

.mc-code-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.mc-notice {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 24rpx;
  line-height: 1.6;
}

.rule {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}

.rule-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 20rpx 0 4rpx;
  border-radius: 50%;
  background: #1677ff;
  flex: none;
}

.rule-text {
  flex: 1;
  font-size: 28rpx;
}

.rule-title {
  color: #0f172a;
}

.rule-detail {
  margin-left: 16rpx;
  color: #64748b;
}

.entry {
  display: flex;
  align-items: center;
}

.entry-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.entry-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.recent-all {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #64748b;
}

.recent-chevron {
  margin-left: 8rpx;
  width: 12rpx;
  height: 12rpx;
}

.recent-empty {
  padding: 32rpx 0 8rpx;
  font-size: 26rpx;
  color: #64748b;
}

/* 卡面内容压在装饰圆上面。 */
.mc-label,
.mc-amount,
.mc-foot,
.mc-notice {
  position: relative;
}

.benefit-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

/* 待签提醒条：浅橙底，不抢余额的层级；首页主按钮仍然只有一个。 */
.sign-banner {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx;
  border-radius: 24rpx;
  background: #fff7ed;
}

.sign-banner-icon {
  width: 48rpx;
  height: 48rpx;
  flex: none;
}

.sign-banner-text {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.sign-banner-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #9a3412;
}

.sign-banner-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #b45309;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sign-banner-go {
  margin-left: 16rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 1rpx solid #f59e0b;
  color: #b45309;
  font-size: 26rpx;
  flex: none;
}

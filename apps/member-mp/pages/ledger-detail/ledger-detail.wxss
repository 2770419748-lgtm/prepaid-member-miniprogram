.head {
  padding: 48rpx 32rpx;
  text-align: center;
}

.head-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #64748b;
}

.head-tag {
  margin-left: 12rpx;
}

.head-amount-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 16rpx;
}

.head-amount {
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.head-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #64748b;
}

.notice-link {
  margin-left: 12rpx;
  color: #1677ff;
}

.rows {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: #64748b;
  flex: none;
}

.row-value {
  margin-left: 32rpx;
  text-align: right;
  color: #0f172a;
  word-break: break-all;
}

.row-id {
  font-size: 24rpx;
  color: #64748b;
}

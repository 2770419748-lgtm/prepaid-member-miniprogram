<view class="page">
  <view class="card profile">
    <view class="avatar">{{initial}}</view>
    <view class="profile-text">
      <view class="profile-name">{{name}}</view>
      <view class="profile-phone">{{phoneText}}</view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="openLedger">
      <image class="menu-icon" src="/images/icon-ledger.png"></image>
      <text class="menu-text">使用明细</text>
      <view class="chevron"></view>
    </view>
    <view class="menu-item" bindtap="openBenefits">
      <image class="menu-icon" src="/images/icon-benefit.png"></image>
      <text class="menu-text">会员权益</text>
      <view class="chevron"></view>
    </view>
    <view class="menu-item" bindtap="openSignList">
      <image class="menu-icon" src="/images/icon-contract.png"></image>
      <text class="menu-text">我的权益单</text>
      <view class="chevron"></view>
    </view>
    <view class="menu-item" bindtap="openStores">
      <image class="menu-icon" src="/images/icon-store-gray.png"></image>
      <text class="menu-text">可用门店</text>
      <view class="chevron"></view>
    </view>
    <view class="menu-item" bindtap="showRules">
      <image class="menu-icon" src="/images/icon-info.png"></image>
      <text class="menu-text">储值说明</text>
      <view class="chevron"></view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="logout">
      <image class="menu-icon" src="/images/icon-logout.png"></image>
      <text class="menu-text">退出登录</text>
    </view>
  </view>

  <view class="footer-note">充值和消费请到门店办理</view>
</view>

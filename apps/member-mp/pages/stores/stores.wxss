.stores-empty {
  padding: 160rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
}

.locate-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(22, 119, 255, 0.06);
  font-size: 26rpx;
}

.locate-text {
  color: #334155;
}

.locate-action {
  margin-left: 24rpx;
  color: #1677ff;
  font-weight: 500;
  flex: none;
}

.store {
  display: flex;
  align-items: center;
}

.store-info {
  flex: 1;
  min-width: 0;
}

.store-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #0f172a;
}

.store-line {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #64748b;
}

.store-distance {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #1677ff;
}

.store-actions {
  margin-left: 24rpx;
  flex: none;
  display: flex;
  flex-direction: column;
}

.store-btn {
  width: 128rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
}

.store-nav {
  background: #1677ff;
  color: #ffffff;
}

.store-call {
  margin-top: 16rpx;
  background: #ffffff;
  color: #0f172a;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.store-btn-off {
  opacity: 0.4;
}

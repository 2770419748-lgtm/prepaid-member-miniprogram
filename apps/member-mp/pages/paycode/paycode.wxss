.code-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
}

.cc-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cc-title {
  font-size: 34rpx;
  font-weight: 600;
}

.cc-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.qr-box {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  margin: 40rpx auto 8rpx;
}

.qr {
  width: 440rpx;
  height: 440rpx;
}

.qr-skeleton {
  width: 440rpx;
  height: 440rpx;
}

/* 门店扫过以后盖在码上，码不再能被别人扫。 */
.qr-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 16rpx;
}

.scan-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #1677ff;
  box-shadow: 0 0 0 12rpx rgba(22, 119, 255, 0.15);
}

.mask-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.mask-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #64748b;
}

.cc-balance {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 24rpx;
  font-size: 26rpx;
}

.balance {
  margin: 0 8rpx 0 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.cc-refresh {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e2e8f0;
  font-size: 24rpx;
  color: #94a3b8;
}

.refresh-link {
  margin-left: 16rpx;
}

.cc-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 16rpx 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
}

.cc-message .retry {
  margin-top: 32rpx;
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e2e8f0;
  color: #0f172a;
}

.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

/* 绿色圆里一个对勾，用边框画，不依赖图片。 */
.done-icon {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #16a34a;
}

.done-icon::after {
  content: '';
  position: absolute;
  left: 38rpx;
  top: 26rpx;
  width: 24rpx;
  height: 44rpx;
  border-right: 8rpx solid #ffffff;
  border-bottom: 8rpx solid #ffffff;
  transform: rotate(45deg);
}

.done-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.done-amount {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.done-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 400;
}

.done-rows {
  align-self: stretch;
  margin-top: 32rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #e2e8f0;
}

.done-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.strong {
  font-weight: 600;
}

.gap {
  margin-top: 24rpx;
}

.tips {
  padding: 0 8rpx;
}

.tip {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #64748b;
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 16rpx 16rpx 0 0;
  border-radius: 50%;
  background: #94a3b8;
  flex: none;
}

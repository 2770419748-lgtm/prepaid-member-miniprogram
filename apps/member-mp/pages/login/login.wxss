@import "../../styles/member.wxss";

page {
  background: #ffffff;
}

.login {
  min-height: 100vh;
  padding: 120rpx 48rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-card {
  width: 72rpx;
  height: 48rpx;
  border-radius: 8rpx;
  border: 5rpx solid #ffffff;
  box-sizing: border-box;
  position: relative;
}

.brand-card::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 10rpx;
  height: 6rpx;
  background: #ffffff;
}

.brand-name {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.brand-desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #64748b;
}

.actions {
  margin-top: 120rpx;
}

.note {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
  text-align: center;
}

.offline {
  margin-top: auto;
  padding-top: 64rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
}

/* 审核体验入口：只在商家后台打开「审核体验」时显示，做得很小，不打扰顾客。 */
.review {
  padding-top: 24rpx;
  text-align: center;
}

.review-link {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.review-form {
  margin-top: 16rpx;
  text-align: left;
}

.review-input {
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #ffffff;
}

.review-placeholder {
  color: #94a3b8;
}

.review-error {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.review-btn {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

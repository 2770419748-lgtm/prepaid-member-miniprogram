{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2018"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "tests"]
}

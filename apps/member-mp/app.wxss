/*
 * 会员页和工作台共用一个小程序，两边各有一套样式，按页面引入，互不影响：
 * - 会员页（pages/）引入 styles/member.wxss；
 * - 工作台（staff/pages/）引入 staff/staff.wxss。
 * 这里只放两边都一样的基础样式。色板和字号见 docs/design/ui-design.md v1.1。1px = 2rpx。
 */

page {
  background: #f8fafc;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

button::after {
  border: none;
}

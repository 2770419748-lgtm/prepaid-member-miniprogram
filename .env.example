# App
NODE_ENV=development
API_PORT=3000

# Database
DATABASE_URL=postgresql://prepaid:prepaid@localhost:5432/prepaid_member?schema=public

# Auth（M1 会用；M0 先占位）
JWT_SECRET=change-me-in-local-only

# Redis（可选；暂不用可留空）
REDIS_URL=

# WeChat — 测试号（入职前）；与技术部约定名一致
WECHAT_MEMBER_APPID=
WECHAT_MEMBER_SECRET=
WECHAT_STAFF_APPID=
WECHAT_STAFF_SECRET=

# e签宝 — 沙箱
ESIGN_APP_ID=
ESIGN_APP_SECRET=
ESIGN_API_HOST=https://smlopenapi.esign.cn
# 正式签署总开关：默认 false；true 仅在主体与企业章就绪后由运维打开
# 配置项名 esign.production.enabled ↔ 环境变量 ESIGN_PRODUCTION_ENABLED
ESIGN_PRODUCTION_ENABLED=false

# Object storage（合同 PDF；M0 可先本地目录或 MinIO 占位）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 商家后台（apps/admin-web）使用 Vite 变量，见 apps/admin-web/.env.development
# VITE_API_BASE=http://localhost:3000

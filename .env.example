# App
NODE_ENV=development
API_PORT=3000

# Database
DATABASE_URL=postgresql://prepaid:prepaid@localhost:5432/prepaid_member?schema=public

# Auth
JWT_SECRET=change-me-in-local-only
# 登录凭证有效期。支持秒数或 12h、15m、7d。默认 12 小时。
JWT_EXPIRES_IN=12h
# 网页后台员工登录使用手机号和密码（bcrypt 哈希），不使用短信验证码。
# 小程序仍使用下面的微信手机号登录。
# 本地演示用假手机号登录。默认关闭。NODE_ENV=production 时即使写成 true 也不生效。
WECHAT_PHONE_MOCK=false

# Redis（可选；暂不用可留空）
REDIS_URL=

# WeChat — 测试号（入职前）；与技术部约定名一致
WECHAT_MEMBER_APPID=
WECHAT_MEMBER_SECRET=
WECHAT_STAFF_APPID=
WECHAT_STAFF_SECRET=

# e签宝 — 沙箱
ESIGN_APP_ID=
ESIGN_APP_SECRET=
ESIGN_API_HOST=https://smlopenapi.esign.cn
# 正式签署总开关：默认 false；true 仅在主体与企业章就绪后由运维打开
# 配置项名 esign.production.enabled ↔ 环境变量 ESIGN_PRODUCTION_ENABLED
ESIGN_PRODUCTION_ENABLED=false
# e签宝回调地址（公网可访问的 https://<api>/webhooks/esign）。本地留空，签完后用刷新接口同步状态
ESIGN_NOTIFY_URL=
# 会员签完后签署页跳回的地址。留空则停在 e签宝完成页
ESIGN_REDIRECT_URL=

# Object storage（合同 PDF）。配了 S3_ENDPOINT + S3_BUCKET 走 S3 / MinIO；
# 不配则存到 STORAGE_LOCAL_DIR（默认 apps/api/.storage/，只用于开发，不进 Git）
# 本地 MinIO：docker compose --profile storage up -d，然后 S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_DIR=

# 商家后台（apps/admin-web）使用 Vite 变量，见 apps/admin-web/.env.development
# VITE_API_BASE=http://localhost:3000
